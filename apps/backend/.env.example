# Skopiuj do .env (plik .env jest ignorowany przez git)
APP_NAME=Card Swipe API
ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Turso (produkcja na Vercelu): DATABASE_URL=libsql://<baza>.turso.io
# Token z `turso db tokens create <baza>`; nigdy nie commituj prawdziwego tokenu
DATABASE_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:5173
API_KEY=change-me
# GET /geocode: podpowiedzi adresów z Photon (dane OpenStreetMap), z identyfikującym User-Agent
GEOCODE_USER_AGENT=spootted/0.1 (HackYeah 2026 demo)
# Klucz OpenCode do modelu Jev (rekomendacje); bez klucza działa losowy zapas
OPENCODE_API_KEY=
# jev-1.13-free (darmowy, ograniczony czasowo) albo jev-1.13 (płatny)
JEV_MODEL=jev-1.13-free
JEV_URL=https://opencode.ai/zen/v1/systemone
JEV_TIMEOUT_SECONDS=8
# POST /events/parse (autouzupełnianie wydarzenia): model czatu z OpenCode Zen, ten sam OPENCODE_API_KEY
PARSE_MODEL=minimax-m2.5-free
PARSE_URL=https://opencode.ai/zen/v1/chat/completions
PARSE_TIMEOUT_SECONDS=20
# Monitoring wywołań Jev w LangSmith; bez klucza monitoring jest wyłączony
# Klucz tylko w .env i w zmiennych Vercela, nigdy w repozytorium; konto EU wymaga własnego adresu w LANGSMITH_ENDPOINT
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spotted-jev
LANGSMITH_ENDPOINT=
