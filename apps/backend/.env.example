# Skopiuj do .env (plik .env jest ignorowany przez git)
APP_NAME=Card Swipe API
ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./app.db
CORS_ORIGINS=http://localhost:5173
API_KEY=change-me
# Klucz do LLM API używanego w POST /events/parse
LLM_API_KEY=
# Nominatim wymaga identyfikującego User-Agent
NOMINATIM_USER_AGENT=hackyeah-studencka-mapa/0.1
